FROM node:26-alpine

WORKDIR /app

# su-exec lets the startup command repair permissions on a reused Docker volume,
# then run Vite as the non-root node user.
RUN apk add --no-cache su-exec
RUN chown node:node /app

COPY --chown=node:node package*.json ./
RUN su-exec node npm install

COPY --chown=node:node . .

EXPOSE 5173

# Anonymous node_modules volumes can retain root ownership from an older image.
# Fix only that dependency volume, then keep generated project files host-writable.
CMD ["sh", "-c", "chown -R node:node /app/node_modules && exec su-exec node npm run dev -- --host 0.0.0.0"]
